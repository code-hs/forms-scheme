	"pages": [
		{
			"id": 1,
			"key": "main",
			"description": "Conditional Offer of Employment",
			"components": [
				{
					"common": {
						"type": "TextContainer",
						"class": {
							"container": "--center"
						}
					},
					"custom": {
						"tag": "h2"
					},
					"text": {
						"value": "#text title"
					}
				},
				{
					"common": {
						"type": "HtmlContainer"
					},
					"custom": {
						"bodyHTML": "#<div class='form-check form-switch'> \n<label class='form-check-label'>\n\t<input class='form-check-input' type='checkbox' role='switch' data-common-model='my-custom-checkbox'> \n\tDefault switch checkbox input\n</label>\t\n</div>"
					}
				},

				{
					"common": {
						"type": "MultiBox",
						"model": "workRecords"
					},
					"custom": {
						"title": "#record-",
						"addIndex": true
					},
					"initialize": {
						"mode": "self"
					},
					"components": [
						{
							"common": {
								"type": "LayoutContainer",
								"class": {
									"container": "g-2-cols"
								}
							},
							"components": [
								{
									"common": {
										"type": "InputText",
										"model": "firstName"
									},
									"validation": {
										"required": true,
										"texts": {
											"required": "errors.required"
										}
									},
									"text": {
										"label": "firstname"
									}
								},

								{
									"common": {
										"type": "HtmlContainer"
									},
									"custom": {
										"bodyHTML": "#<input class='js-choice' data-common-model='my-choice-in-multibox' type='text' value='default value' placeholder='Enter something' />"
									}
								}
							]
						}
					]
				},

				{
					"common": {
						"type": "ButtonSubmit",
						"class": {
							"container": "col-3 col-5-sm --col-middle"
						}
					},
					"text": {
						"value": "continue"
					}
				}
			]
		}
	]
