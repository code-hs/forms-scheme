							"ua": "uk",
							"fr": "fr",
							"cn": "zh-CN",
							"jp": "ja"
						}
					},
					"forEachField": {
						"format": "mm/dd/yyyy",
						"autohide": true,
						"todayHighlight": true
					}
				}
			},

			{
				"name": "menu",
				"enable": false,
				"config": {
					"stepMode": true,
					"list": [
						{
							"id": 11,
