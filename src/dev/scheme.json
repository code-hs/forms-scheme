{
	"config": {
		"modules": [
			{
				"name": "datepicker",
				"config": {
					"locales": {
						"relations": {
							"ua": "uk",
							"fr": "fr",
							"cn": "zh-CN",
							"jp": "ja"
						}
					},
					"forEachField": {
						"format": "mm/dd/yyyy",
						"autohide": true,
						"todayHighlight": true
					}
				}
			},

			{
				"name": "menu",
				"config": {
					"list": [
						{
							"id": 1,
							"pageId": 1,
							"position": 1,
							"title": "#custom-fields"
						},
						{
							"id": 2,
							"pageId": 2,
							"position": 2,
							"title": "#elements-in-html"
						}
					]
				}
			}
		],
		"apiBaseUrl": "http://localhost:8081/api/",
		"localization": {
			"defaultLang": "en",
			"availableLangs": [
				"en",
				"fr",
				"de",
				"ua",
				"ru",
				"cn",
				"es",
				"jp",
				"it",
				"pt"
			]
		}
	},
	"pages": [
		{
			"id": 1,
			"key": "custom-fields",
			"description": "demo custom fields",
			"components": [
				{
					"common": {
						"type": "TextContainer",
						"class": {
							"container": "t-center"
						}
					},
					"custom": {
						"tag": "h2"
					},
					"text": {
						"value": "#text title"
					}
				},

				{
					"common": {
						"type": "HtmlContainer"
					},
					"custom": {
						"htmlContent": "#<div class='form-check form-switch'> \n<label class='form-check-label'>\n\t<input class='form-check-input' type='checkbox' role='switch' data-common-model='my-custom-checkbox-main'> \n\t checkbox 11 \n</label>\t\n</div>"
					}
				},

				{
					"common": {
						"type": "MultiBox",
						"model": "workRecords"
					},
					"custom": {
						"title": "#record-",
						"addIndex": true
					},
					"initialize": {
						"mode": "self"
					},
					"components": [
						{
							"common": {
								"type": "LayoutContainer",
								"class": {
									"container": "g-3-cols"
								}
							},
							"components": [
								{
									"common": {
										"type": "HtmlContainer"
									},
									"custom": {
										"htmlContent": "#<div class='form-check form-switch'> \n<label class='form-check-label'>\n\t<input class='form-check-input' type='checkbox' role='switch' data-common-model='my-custom-checkbox'> \n\t checkbox \n</label>\t\n</div>"
									}
								},

								{
									"common": {
										"type": "InputText",
										"model": "firstName"
									},
									"validation": {
										"required": true,
										"texts": {
											"required": "errors.required"
										}
									},
									"text": {
										"label": "firstname"
									}
								},

								{
									"common": {
										"type": "HtmlContainer"
									},
									"custom": {
										"htmlContent": "#<input class='js-choice' data-common-model='my-choice-in-multibox' type='text' value='default value' placeholder='Enter something' />"
									}
								}
							]
						}
					]
				},

				{
					"common": {
						"type": "ButtonSubmit",
						"class": {
							"container": "col-3 col-5-sm m-middle"
						}
					},
					"text": {
						"value": "continue"
					}
				}
			]
		},

		{
			"id": 2,
			"key": "elements-in-html",
			"description": "elements in html",
			"components": [
				{
					"common": {
						"type": "InputDate",
						"model": "birthDate",
						"renderInHTMLTag": "datepicker-birth"
					},
					"initialize": {
						"mode": "self"
					},
					"module": {
						"minDate": "01/01/1920",
						"maxDate": "01/01/2005"
					},
					"restrict": {
						"mask": "##/##/####"
					},
					"validation": {
						"required": true,
						"texts": {
							"required": "errors.required",
							"range": "birthDate.range",
							"notValid": "date.not-valid"
						}
					},
					"text": {
						"placeholder": "birthDate.placeholder",
						"label": "birthDate.label",
						"hint": "date.hint"
					}
				},

				{
					"common": {
						"type": "InputDate",
						"model": "birthDate2",
						"renderInHTMLTag": "datepicker-birth2"
					},
					"initialize": {
						"mode": "self"
					},
					"module": {
						"minDate": "01/01/1920",
						"maxDate": "01/01/2005"
					},
					"restrict": {
						"mask": "##/##/####"
					},
					"validation": {
						"required": true,
						"texts": {
							"required": "errors.required",
							"range": "birthDate.range",
							"notValid": "date.not-valid"
						}
					},
					"text": {
						"placeholder": "birthDate.placeholder",
						"label": "birthDate.label",
						"hint": "date.hint"
					}
				},

				{
					"common": {
						"type": "HtmlContainer"
					},
					"custom": {
						"downloadFileName": "render-element-ex-2",
						"htmlContent22": "#<div class=\"login-form\">\n\t\t\t<div class=\"field\">\n\t\t\t\t<span class=\"label\">datepicker Birth </span>\n\t\t\t\t<div class=\"input\"> <div data-render-tag=\"datepicker-birth\"> </div> </div>\n\t\t\t</div>\n\n\t\t\t<div class=\"field\">\n\t\t\t\t<span class=\"label\">datepicker Birth 2</span>\n\t\t\t\t<div class=\"input\"> <div data-render-tag=\"datepicker-birth2\"> </div> </div>\n\t\t\t</div>\n\t\t</div>"
					}
				},

				{
					"common": {
						"type": "ButtonSubmit",
						"class": {
							"container": "col-3 col-5-sm m-middle"
						}
					},
					"text": {
						"value": "submit"
					}
				}
			]
		},
		{
			"id": 3,
			"key": "validation",
			"components": [
				{
					"common": {
						"type": "InputText",
						"model": "firstName"
					},
					"initialize": {
						"mode": "self"
					},
					"restrict": {
						"pattern": "/^[a-zа-я_ ]{0,28}$/i"
					},
					"validation": {
						"required": true,
						"texts": {
							"required": "errors.required"
						}
					},
					"text": {
						"label": "firstname"
					}
				},
				{
					"common": {
						"type": "InputText",
						"model": "lastName"
					},
					"restrict": {
						"pattern": "/^[a-zа-я_ ]{0,28}$/i"
					},
					"initialize": {
						"mode": "self"
					},
					"validation": {
						"required": true,
						"texts": {
							"required": "errors.required"
						}
					},
					"text": {
						"label": "lastname"
					}
				},
				{
					"common": {
						"type": "Checkbox",
						"model": "agree",
						"class": {
							"container": "t-center"
						}
					},
					"custom": {
						"htmlContent": "#agree"
					},
					"initialize": {
						"mode": "self"
					},
					"validation": {
						"required": true
					}
				},
				{
					"common": {
						"type": "Radiobuttons",
						"model": "drugTest",
						"class": {
							"container": "--radio-space-evenly"
						}
					},
					"custom": {
						"options": [
							{
								"value": "yes",
								"text": "yes"
							},
							{
								"value": "no",
								"text": "no"
							}
						]
					},
					"initialize": {
						"mode": "self"
					},
					"text": {
						"label": "#drug-test"
					},
					"validation": {
						"required": true
					}
				},

				{
					"common": {
						"type": "InputDate",
						"model": "birthDate"
					},
					"initialize": {
						"mode": "self"
					},
					"module": {
						"minDate": "01/01/1920",
						"maxDate": "01/01/2005"
					},
					"restrict": {
						"mask": "##/##/####"
					},
					"validation": {
						"required": true,
						"texts": {
							"required": "errors.required",
							"range": "birthDate.range",
							"notValid": "date.not-valid"
						}
					},
					"text": {
						"placeholder": "birthDate.placeholder",
						"label": "birthDate.label",
						"hint": "date.hint"
					}
				},

				{
					"common": {
						"type": "LayoutContainer",
						"class": {
							"container": "g-2-cols"
						}
					},
					"components": [
						{
							"common": {
								"type": "InputDate",
								"model": "startDate"
							},
							"custom": {
								"workTogether": {
									"selfIdentify": "START",
									"purposeModel": "endDate",
									"validateText": "date.range.error.start"
								}
							},
							"module": {
								"minDate": "01/01/1920"
							},
							"restrict": {
								"mask": "##/##/####"
							},
							"validation": {
								"required": true,
								"texts": {
									"required": "errors.required",
									"range": "date.range-out",
									"notValid": "date.not-valid"
								}
							},
							"text": {
								"placeholder": "#example: 12/25/2000",
								"label": "#start-date.label",
								"hint": "date.hint"
							}
						},
						{
							"common": {
								"type": "InputDate",
								"model": "endDate"
							},
							"custom": {
								"workTogether": {
									"selfIdentify": "END",
									"purposeModel": "startDate",
									"validateText": "date.range.error.end"
								}
							},
							"module": {
								"minDate": "01/01/1920"
							},
							"restrict": {
								"mask": "##/##/####"
							},
							"validation": {
								"required": true,
								"texts": {
									"required": "errors.required",
									"range": "date.range-out",
									"notValid": "date.not-valid"
								}
							},
							"text": {
								"placeholder": "#example: 12/25/2000",
								"label": "#end-date.label",
								"hint": "date.hint"
							}
						}
					]
				},

				{
					"common": {
						"type": "ButtonSubmit",
						"class": {
							"container": "col-5 col-5-sm m-middle"
						}
					},
					"text": {
						"value": "submit"
					}
				}
			]
		}
	]
}
