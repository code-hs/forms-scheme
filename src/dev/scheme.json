{
	"config": {
		"modules": [
			{
				"name": "datepicker",
				"config": {
					"locales": {
						"relations": {
							"ua": "uk",
							"fr": "fr",
							"cn": "zh-CN",
							"jp": "ja"
						}
					},
					"forEachField": {
						"format": "mm/dd/yyyy",
						"autohide": true,
						"todayHighlight": true
					}
				}
			}
		],
		"apiBaseUrl": "http://localhost:8081/api/",
		"localization": {
			"defaultLang": "en",
			"availableLangs": [
				"en",
				"fr",
				"de",
				"ua",
				"ru",
				"cn",
				"es",
				"jp",
				"it",
				"pt"
			]
		}
	},
	"pages": [
		{
			"id": 1,
			"key": "custom-fields",
			"description": "demo custom fields",
			"components": [
				{
					"common": {
						"type": "TextContainer",
						"class": {
							"container": "t-center"
						}
					},
					"custom": {
						"tag": "h2"
					},
					"text": {
						"value": "#text title"
					}
				},

				{
					"common": {
						"type": "HtmlContainer"
					},
					"custom": {
						"bodyHTML": "#<div class='form-check form-switch'> \n<label class='form-check-label'>\n\t<input class='form-check-input' type='checkbox' role='switch' data-common-model='my-custom-checkbox-main'> \n\t checkbox 11 \n</label>\t\n</div>"
					}
				},

				{
					"common": {
						"type": "MultiBox",
						"model": "workRecords"
					},
					"custom": {
						"title": "#record-",
						"addIndex": true
					},
					"initialize": {
						"mode": "self"
					},
					"components": [
						{
							"common": {
								"type": "LayoutContainer",
								"class": {
									"container": "g-3-cols"
								}
							},
							"components": [
								{
									"common": {
										"type": "HtmlContainer"
									},
									"custom": {
										"bodyHTML": "#<div class='form-check form-switch'> \n<label class='form-check-label'>\n\t<input class='form-check-input' type='checkbox' role='switch' data-common-model='my-custom-checkbox'> \n\t checkbox \n</label>\t\n</div>"
									}
								},

								{
									"common": {
										"type": "InputText",
										"model": "firstName"
									},
									"validation": {
										"required": true,
										"texts": {
											"required": "errors.required"
										}
									},
									"text": {
										"label": "firstname"
									}
								},

								{
									"common": {
										"type": "HtmlContainer"
									},
									"custom": {
										"bodyHTML": "#<input class='js-choice' data-common-model='my-choice-in-multibox' type='text' value='default value' placeholder='Enter something' /> <script> console.log('123') </script>"
									}
								}
							]
						}
					]
				},

				{
					"common": {
						"type": "ButtonSubmit",
						"class": {
							"container": "col-3 col-5-sm m-middle"
						}
					},
					"text": {
						"value": "continue"
					}
				}
			]
		},

		{
			"id": 2,
			"key": "elements-in-html",
			"description": "elements in html",
			"components": [
				{
					"common": {
						"type": "HtmlContainer"
					},
					"custom": {
						"bodyHTML": "#<span> test text 1 </span> renderElement(datepickerBirth) <span> test text 2 </span>"
					}
				},
				{
					"common": {
						"type": "InputDate",
						"model": "birthDate",
						"renderInHTMLTag": "datepickerBirth"
					},
					"initialize": {
						"mode": "self"
					},
					"module": {
						"minDate": "01/01/1920",
						"maxDate": "01/01/2005"
					},
					"restrict": {
						"mask": "##/##/####"
					},
					"validation": {
						"required": true,
						"texts": {
							"required": "errors.required",
							"range": "birthDate.range",
							"notValid": "date.not-valid"
						}
					},
					"text": {
						"placeholder": "birthDate.placeholder",
						"label": "birthDate.label",
						"hint": "date.hint"
					}
				}
			]
		}
	]
}
