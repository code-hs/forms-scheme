				"next-form .instruction {padding: 24px 32px; margin-bottom: 16px; border-radius: 4px; text-align: justify;}",
				"next-form .nf-app[data-theme='dark'] .instruction {background-color:hsl(210 2% 20% / 1);}",
				"next-form .nf-app[data-theme='light'] .instruction {background-color: #f3f3f3;}",

