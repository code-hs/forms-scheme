				},
				{
					"common": {
						"type": "layoutColumns",
						"enable": true
					},
					"components": [
						{
							"common": {
								"type": "LayoutColumn"
							},
							"components": [
								{
									"common": {
										"type": "InputText",
										"model": "cellPhoneNumber"
